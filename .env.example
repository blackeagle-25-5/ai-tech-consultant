# Copy to .env and fill in. Never commit .env.
# Model provider. This project runs on Groq (free tier, console.groq.com) because no Claude budget was available.
# Claude is used automatically if ANTHROPIC_API_KEY is set; force either with LLM_PROVIDER=groq|anthropic.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=
# Groq model playing each Claude role (defaults shown).
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional: protects the Knowledge Brain API. Clients send it as X-API-Key.
KB_API_KEY=
# In single-service deployment, defaults to internal API. In dual-service deployment, set to your deployed API URL.
KB_API_URL=http://127.0.0.1:8000
# Scheduled background crawl (set to 0 on Render to avoid background re-crawling on cold boots)
KB_DAILY_SYNC=0
# Crawl politeness
CRAWL_CONCURRENCY=2
CRAWL_DELAY_S=1.0
# Max screenshots to describe with Claude vision per ingestion run
MAX_IMAGES=4000

