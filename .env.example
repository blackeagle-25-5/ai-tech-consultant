# Copy to .env and fill in. Never commit .env.
# Claude is required by the assignment for final results and the demo.
ANTHROPIC_API_KEY=
# TEMPORARY development fallback while no Claude credit is available (free tier at console.groq.com).
# Used automatically when ANTHROPIC_API_KEY is empty; force with LLM_PROVIDER=groq or LLM_PROVIDER=anthropic.
GROQ_API_KEY=
LLM_PROVIDER=
# Groq model playing each Claude role (defaults shown).
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional: protects the Knowledge Brain API. Clients send it as X-API-Key.
KB_API_KEY=
KB_API_URL=http://127.0.0.1:8000
# Crawl politeness
CRAWL_CONCURRENCY=2
CRAWL_DELAY_S=1.0
# Max screenshots to describe with Claude vision per ingestion run
MAX_IMAGES=4000
